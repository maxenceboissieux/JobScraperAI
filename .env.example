# Configuration générale
JOBSCRAPER_LOG_LEVEL=INFO

# Base et cache locaux (chemin relatif à la racine du projet)
JOBSCRAPER_DATABASE_URL=sqlite:///./data/jobscraper.db
JOBSCRAPER_DATA_DIR=./data

# Fuseau utilisé pour le rattrapage de la synchronisation quotidienne
JOBSCRAPER_TIMEZONE=Europe/Paris

# Adzuna (optionnel)
ADZUNA_APP_ID=votre_app_id
ADZUNA_APP_KEY=votre_app_key

# Free-Work (pages publiques, sans clé API)
FREEWORK_DELAY=2.0
